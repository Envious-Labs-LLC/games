# Dependencies
node_modules/
.pnpm-store/

# Build output (reproducible; never commit)
dist/
build/
out/
coverage/
*.tsbuildinfo

# Generated assets (built from assets/source/ via the pipeline)
**/assets/generated/

# Desktop packaging output
release/
*.dmg
*.exe
*.AppImage

# Test + tooling artifacts
playwright-report/
test-results/
.vite/

# Secrets (source of truth: GCP Secret Manager / Keychain)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local scratch
/tmp/
*.local

# Crash bundles / failure replays are kept; golden replays are committed.
# (replays/failures/ is local debug output)
**/replays/failures/
