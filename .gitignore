# Dependencies
node_modules/
.pnpm-store/

# Build output (reproducible; never commit)
dist/
build/
out/
coverage/
*.tsbuildinfo

# Generated assets (built from assets/source/ via the pipeline)
**/assets/generated/

# Desktop packaging output
release/
*.dmg
*.exe
*.AppImage

# Test + tooling artifacts
playwright-report/
test-results/
.vite/

# Secrets (source of truth: GCP Secret Manager / Keychain)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local scratch
/tmp/
*.local

# Crash bundles / failure replays are kept; golden replays are committed.
# (replays/failures/ is local debug output)
**/replays/failures/

# Games live in their own GitHub repos (founder rule 2026-07-26), not in the
# studio repo. Ignored here so a stray `git add -A` cannot record one as a broken
# submodule pointer instead of real files.
#   project-trishul -> github.com/saurabhav88/project-trishul
#   moonwheat       -> github.com/Envious-Labs-LLC/moonwheat
# hanuman-wind-lab and flame-of-lanka were early prototypes of the same game as
# Trishul; on 2026-07-26 they moved into that repo under prototypes/, with their
# full commit history. Their history also remains in this repo before that date.
/games/project-trishul/
/games/moonwheat/
# Leftover local working copies of the two migrated prototypes. Their content now
# lives in project-trishul under prototypes/. Ignored so they can never re-enter
# this repo; safe to delete from disk at any time.
/games/hanuman-wind-lab/
/games/flame-of-lanka-prototype/
